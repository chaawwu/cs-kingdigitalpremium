rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // counters: only allow transactions from authenticated users (admin or anonymous)
    match /counters/{doc} {
      allow read: if false;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.uid != null);
    }

    // chats
    match /chats/{chatId} {
      // only authenticated users who present the same customerToken can create their chat
      allow create: if request.auth != null && request.resource.data.customerToken == request.auth.uid;
      // read/update: admin or owner
      allow read, update: if isAdmin() || (request.auth != null && resource.data.customerToken == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        // create message by admin or by chat owner (authenticated)
        allow create: if request.auth != null && (isAdmin() || get(/databases/$(database)/documents/chats/$(chatId)).data.customerToken == request.auth.uid);
        // read messages by admin or owner
        allow read: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.customerToken == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // products: admin only for write, everyone can read
    match /products/{prodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }

  function isAdmin() {
    return request.auth != null && request.auth.token.admin == true;
  }
}
